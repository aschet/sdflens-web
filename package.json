{
  "name": "sdflens-web",
  "version": "1.1.1",
  "description": "Browser viewer for ISO 25178-71 SDF and ISO 25178-72 x3p files",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run build && npm run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aschet/sdflens-web.git"
  },
  "homepage": "https://aschet.github.io/sdflens-web/",
  "engines": {
    "node": ">=22.12"
  },
  "author": "Thomas Ascher <thomas.ascher@gmx.at>"
}
